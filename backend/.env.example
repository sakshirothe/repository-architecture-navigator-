# Copy this file to .env and fill in your values

# Optional: Add your OpenAI API key to enable AI-powered summaries and Q&A
# Without this, the app uses rule-based analysis (still fully functional)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Add a GitHub Personal Access Token to increase API rate limits
# Without this, you're limited to 60 requests/hour (unauthenticated)
# With a token, you get 5,000 requests/hour
# Generate one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_token_here
